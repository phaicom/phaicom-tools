{
  "name": "phaicom-tools",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "Reawpai Chunsoi <reawpai.chunsoi@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/nodejs_*/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@react-aria/optimize-locales-plugin": "^2.0.2",
    "@react-router/fs-routes": "^8.3.1",
    "@react-router/node": "7.14.0",
    "@react-router/serve": "7.14.0",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@uiw/react-codemirror": "^4.25.11",
    "@vercel/react-router": "^1.3.6",
    "adm-zip": "^0.6.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "html-minifier-terser": "^7.2.0",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router": "7.14.0",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "prosemirror-model": "1.25.11"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "bun run lint",
      "bun run lint:fix",
      "bun run fmt"
    ],
    "**/*.json": [
      "bun run fmt"
    ]
  },
  "packageManager": "bun@1.4.2"
}
